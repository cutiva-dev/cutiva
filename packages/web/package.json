{
  "name": "@cutiva/web",
  "version": "0.0.1",
  "description": "Web engine for Cutiva: import, preview and MP4 export with WebCodecs and Mediabunny.",
  "license": "Apache-2.0",
  "author": "Cutiva contributors",
  "homepage": "https://cutiva.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cutiva-dev/cutiva.git",
    "directory": "packages/web"
  },
  "bugs": "https://github.com/cutiva-dev/cutiva/issues",
  "keywords": [
    "video",
    "video-editing",
    "webcodecs",
    "mp4",
    "export",
    "sdk"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@cutiva/core": "0.0.1",
    "mediabunny": "1.61.3"
  },
  "publishConfig": {
    "access": "public"
  }
}

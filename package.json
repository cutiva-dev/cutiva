{
  "name": "cutiva-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "packages/core",
    "packages/web",
    "packages/react",
    "apps/playground",
    "apps/website"
  ],
  "scripts": {
    "build": "npm run build -w @cutiva/core -w @cutiva/web -w @cutiva/react",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @cutiva/core",
    "test:dart": "cd packages/flutter/cutiva_core && dart pub get && dart analyze --fatal-infos && dart format --line-length 120 --output none --set-exit-if-changed lib test tool example && dart run coverage:test_with_coverage && dart run tool/check_coverage.dart",
    "e2e": "npm run e2e -w @cutiva/playground",
    "test:android": "cd packages/engine-android && ./gradlew :engine:testDebugUnitTest :engine:connectedDebugAndroidTest --console=plain",
    "dev": "npm run dev -w @cutiva/playground",
    "dev:website": "npm run dev -w @cutiva/website",
    "build:website": "npm run build -w @cutiva/website",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && npm run typecheck && npm test && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@vitest/coverage-v8": "2.1.8",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
